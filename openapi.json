          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "doctor_id",
          "patient_id",
          "slot_id",
          "status",
          "reason",
          "created_at"
        ],
        "title": "ConsultationOut"
      },
