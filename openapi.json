      },
      "DoctorCreate": {
        "properties": {
          "specialty": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Specialty"
          },
          "bio": {
            "type": "string",
            "maxLength": 4000,
            "title": "Bio",
            "default": ""
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Languages"
          },
          "consultation_fee_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Consultation Fee Minor",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "specialty"
        ],
        "title": "DoctorCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "mfa_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mfa Code"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "PrescriptionIn": {
        "properties": {
          "items": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Items"
          },
          "instructions": {
            "type": "string",
            "maxLength": 4000,
            "title": "Instructions",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PrescriptionIn"
      },
      "RegisterIn": {
        "properties": {
